{
    "name": "asignua/filament-seo-files",
    "description": "sitemap.xml, robots.txt, llms.txt and llms-full.txt for Filament panels: pluggable page sources, multilingual hreflang, manual sitemap URLs, an editor page and scheduled generation.",
    "keywords": ["filament", "filament-plugin", "laravel", "seo", "sitemap", "robots-txt", "llms-txt", "hreflang"],
    "homepage": "https://github.com/asignua/filament-seo-files",
    "support": {
        "issues": "https://github.com/asignua/filament-seo-files/issues",
        "source": "https://github.com/asignua/filament-seo-files"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "league/html-to-markdown": "^5.1",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-sitemap": "^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentSeoFiles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentSeoFiles\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentSeoFiles\\SeoFilesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
